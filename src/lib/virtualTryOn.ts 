const FAL_API_KEY = import.meta.env.VITE_FAL_API_KEY

export interface TryOnResult {
  success: boolean
  imageUrl?: string
  error?: string
}

/**
 * AI-примерка через Fal.ai (модель IDM-VTON)
 * @param personImage - фото пользователя (base64 или URL)
 * @param garmentImage - фото вещи с прозрачным фоном (base64 или URL)
 * @returns URL изображения с надетой вещью
 */
export async function virtualTryOn(
  personImage: string,
  garmentImage: string
): Promise<TryOnResult> {
  if (!FAL_API_KEY) {
    return {
      success: false,
      error: 'API ключ Fal.ai не настроен. Добавьте VITE_FAL_API_KEY в .env файл.',
    }
  }

  try {
    const response = await fetch('https://fal.run/fal-ai/idm-vton', {
      method: 'POST',
      headers: {
        Authorization: `Key ${FAL_API_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        person_image: personImage,
        garment_image: garmentImage,
        garment_description: '',
      }),
    })

    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}))
      throw new Error(errorData.detail || `HTTP ${response.status}`)
    }

    const data = await response.json()
    
    // Fal.ai возвращает результат в data.output.image.url
    const imageUrl = data.output?.image?.url || data.image?.url
    
    if (!imageUrl) {
      throw new Error('AI не вернул изображение')
    }

    return {
      success: true,
      imageUrl,
    }
  } catch (error: any) {
    console.error('Virtual try-on error:', error)
    return {
      success: false,
      error: error.message || 'Ошибка AI-примерки',
    }
  }
}

/**
 * Проверка доступности AI-сервиса
 */
export async function checkAIAvailability(): Promise<boolean> {
  if (!FAL_API_KEY) return false
  
  try {
    const response = await fetch('https://fal.run/fal-ai/idm-vton', {
      method: 'HEAD',
      headers: {
        Authorization: `Key ${FAL_API_KEY}`,
      },
    })
    return response.status !== 401
  } catch {
    return false
  }
}
const FAL_API_KEY = import.meta.env.VITE_FAL_API_KEY

export interface TryOnResult {
  success: boolean
  imageUrl?: string
  error?: string
}

/**
 * AI-примерка через Fal.ai (модель IDM-VTON)
 */
export async function virtualTryOn(
  personImage: string,
  garmentImage: string
): Promise<TryOnResult> {
  if (!FAL_API_KEY) {
    return {
      success: false,
      error: 'API ключ Fal.ai не настроен. Добавьте VITE_FAL_API_KEY в .env',
    }
  }

  try {
    const response = await fetch('https://fal.run/fal-ai/idm-vton', {
      method: 'POST',
      headers: {
        Authorization: `Key ${FAL_API_KEY}`,
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({
        person_image: personImage,
        garment_image: garmentImage,
        garment_description: '',
      }),
    })

    if (!response.ok) {
      const errorData = await response.json().catch(() => ({}))
      throw new Error(errorData.detail || `HTTP ${response.status}`)
    }

    const data = await response.json()
    const imageUrl = data.output?.image?.url || data.image?.url

    if (!imageUrl) {
      throw new Error('AI не вернул изображение')
    }

    return { success: true, imageUrl }
  } catch (error: any) {
    console.error('Virtual try-on error:', error)
    return { success: false, error: error.message || 'Ошибка AI-примерки' }
  }
}